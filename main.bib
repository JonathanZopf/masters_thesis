  URL = {https://aclanthology.org/2024.acl-short.49/},
  BOOKTITLE = {Proceedings of the 62nd {{Annual Meeting}} of the {{Association}} for {{Computational Linguistics}} ({{Volume}} 2: {{Short Papers}})},
  DOI = {10.18653/v1/2024.acl-short.49},
  EVENTTITLE = {{{ACL}} 2024},
  FILE = {/Users/jonathan/Zotero/storage/U9NE7E5B/Siegel et al. - 2024 - The Probabilities Also Matter A More Faithful Metric for Faithfulness of Free-Text Explanations in.pdf},
